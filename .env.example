# Copy to .env (or export) and adjust.
APP_ENV=development                 # set to "production" to require JWT_SECRET_KEY
DATABASE_URL=sqlite:///./finance_agent.db
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=60
AUTO_CREATE_TABLES=true             # set false when using Alembic migrations

# LLM: any OpenAI-compatible endpoint. Leave OPENAI_API_KEY empty to use the keyword fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.groq.com/openai/v1                               # Groq
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/      # Gemini
# OPENAI_BASE_URL=http://localhost:11434/v1                                     # Ollama

CURRENCY_SYMBOL=₹
AGENT_MAX_STEPS=5
CHAT_HISTORY_LIMIT=10

# Streamlit UI
API_BASE_URL=http://localhost:8003/api/v1
