# Copy to .env and adjust. .env is loaded automatically by the API, the UI and the evals;
# variables already set in the environment take precedence. Never commit .env.
APP_ENV=development                 # set to "production" to require JWT_SECRET_KEY
DATABASE_URL=sqlite:///./finance_agent.db
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=60
AUTO_CREATE_TABLES=true             # set false when using Alembic migrations

# --- LLM ------------------------------------------------------------------------------------
# Any OpenAI-compatible endpoint. Leave OPENAI_API_KEY empty to use the keyword fallback.
# Use exactly one of the provider blocks below.

# Groq (free tier, fast, supports tool calling). Key: https://console.groq.com/keys
# Available models: GET https://api.groq.com/openai/v1/models (gpt-oss-120b works well with tools)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# Gemini (OpenAI-compatible endpoint)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.0-flash

# Ollama (local, no key needed; use any value)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1

# --- Agent ----------------------------------------------------------------------------------
CURRENCY_SYMBOL=₹
AGENT_MAX_STEPS=5
AGENT_TIMEOUT_SECONDS=45
CHAT_HISTORY_LIMIT=10
REQUIRE_WRITE_CONFIRMATION=true     # agent writes need the user's confirmation

# --- Abuse and cost controls (0 disables a limit) -------------------------------------------
CHAT_REQUESTS_PER_MINUTE=20         # per user
AUTH_REQUESTS_PER_MINUTE=10         # per client IP
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
DAILY_TOKEN_BUDGET=200000           # LLM tokens per user per day, then keyword fallback

# --- Streamlit UI ---------------------------------------------------------------------------
API_BASE_URL=http://localhost:8003/api/v1
